NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@RDS_HOST:5432/janpoll?schema=public&sslmode=require
NEXTAUTH_URL=https://janpoll.in
NEXTAUTH_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET
GOOGLE_CLIENT_ID=REPLACE.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE
ENABLE_DEV_LOGIN=false
ADMIN_USER=REPLACE
ADMIN_PASS=REPLACE_WITH_UNIQUE_PASSWORD
ADMIN_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
VOTE_SALT=REPLACE_WITH_STABLE_RANDOM_SECRET
REQUIRE_LOGIN_FOR_ALL_VOTES=true
# Only for direct Nginx->Next where port 3000 is not public:
TRUSTED_IP_HEADER=x-forwarded-for
NEXT_PUBLIC_NETWORK_ADS_ENABLED=true
# AdSense is separate: enable only after approval and valid slot configuration.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
ADS_CONSENT_REVIEWED=false
