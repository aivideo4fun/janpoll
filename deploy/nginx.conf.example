# Example for a DIRECT Nginx -> Next.js deployment.
# An ALB/CloudFront setup requires a separate real-client-IP trust review.
server {
    listen 80;
    server_name janpoll.in www.janpoll.in;
    return 301 https://janpoll.in$request_uri;
}
server {
    listen 443 ssl;
    server_name janpoll.in;
    ssl_certificate /etc/letsencrypt/live/janpoll.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/janpoll.in/privkey.pem;
    client_max_body_size 2m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Middleware-Subrequest "";
        proxy_set_header X-Nextjs-Data "";
        proxy_read_timeout 60s;
        proxy_cache off;
    }
}

server {
    listen 443 ssl;
    server_name www.janpoll.in;
    ssl_certificate /etc/letsencrypt/live/janpoll.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/janpoll.in/privkey.pem;
    return 301 https://janpoll.in$request_uri;
}
