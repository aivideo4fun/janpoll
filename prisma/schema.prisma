datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Connection pool/timeout DATABASE_URL me configure karo (e.g. ?connection_limit=10&pool_timeout=20)
}

generator client {
  provider = "prisma-client-js"
}

model Poll {
  id                String   @id @default(uuid())
  slug              String?  @db.VarChar(500)
  question          String   @db.VarChar(500)
  creatorName       String?  @db.VarChar(100)
  creatorEmail      String?  @db.VarChar(255)
  isVerified        Boolean  @default(false)
  creatorIp         String?  @db.VarChar(45)
  deadlineDays      Int      @default(3)
  active            Boolean  @default(true)

  // Location (purane fields: jaise the waise, sarpanch isi par chalta hai)
  districtName      String?  @db.VarChar(100)
  samitiName        String?  @db.VarChar(100)
  gramPanchayatName String?  @db.VarChar(100)
  gramPanchayatId   String?
  electionType      String?  @default("sarpanch") @db.VarChar(50) // 'sarpanch' | 'samiti' | 'zila'

  // Location (NAYE: asli relations, mandal aur zila ke liye)
  districtId        String?
  district          District?          @relation(fields: [districtId], references: [id], onDelete: SetNull)
  samitiId          String?
  samiti            PanchayatSamiti?   @relation(fields: [samitiId], references: [id], onDelete: SetNull)
  samitiWardId      String?
  samitiWard        SamitiWard?        @relation(fields: [samitiWardId], references: [id], onDelete: SetNull)
  zilaWardId        String?
  zilaWard          ZilaParishadWard?  @relation(fields: [zilaWardId], references: [id], onDelete: SetNull)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  options           PollOption[]
  votes             Vote[]

  @@index([active])
  @@index([createdAt])
  @@index([districtName])
  @@index([samitiName])
  @@index([gramPanchayatName])
  @@index([gramPanchayatId])
  @@index([electionType])
  @@index([districtId])
  @@index([samitiId])
  @@index([samitiWardId])
  @@index([zilaWardId])
}

model PollOption {
  id        String   @id @default(uuid())
  pollId    String
  text      String   @db.VarChar(255)
  voteCount Int      @default(0)
  order     Int?
  createdAt DateTime @default(now())

  poll  Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@index([pollId])
}

model Vote {
  id              String   @id @default(uuid())
  pollId          String
  optionId        String
  anonymousUserId String   @db.VarChar(100)
  ipAddress       String?  @db.VarChar(45)
  deviceSig       String?  @db.VarChar(64)
  createdAt       DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, anonymousUserId])
  @@index([pollId, ipAddress])
  @@index([pollId])
  @@index([optionId])
  @@index([anonymousUserId])
  @@index([createdAt])
  @@index([pollId, createdAt])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(255)
  whatsapp  String?  @db.VarChar(20)
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------
// RAJASTHAN LOCAL BODY HIERARCHY MODELS
// ---------------------------------------------------------

model District {
  id               String             @id @default(cuid())
  nameEn           String             @unique
  nameHi           String
  tehsils          Tehsil[]
  panchayatSamitis PanchayatSamiti[]
  gramPanchayats   GramPanchayat[]
  zilaWards        ZilaParishadWard[]
  polls            Poll[]
  createdAt        DateTime           @default(now())

  @@index([nameEn])
}

model ZilaParishadWard {
  id         String   @id @default(cuid())
  wardNo     Int
  nameHi     String
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  polls      Poll[]

  @@unique([districtId, wardNo])
  @@index([districtId])
}

model Tehsil {
  id               String            @id @default(cuid())
  nameEn           String
  nameHi           String
  districtId       String
  district         District          @relation(fields: [districtId], references: [id], onDelete: Cascade)
  panchayatSamitis PanchayatSamiti[]

  @@unique([districtId, nameEn])
  @@index([districtId])
}

model PanchayatSamiti {
  id             String          @id @default(cuid())
  nameEn         String
  nameHi         String
  districtId     String
  district       District        @relation(fields: [districtId], references: [id], onDelete: Cascade)
  tehsilId       String?
  tehsil         Tehsil?         @relation(fields: [tehsilId], references: [id], onDelete: SetNull)
  samitiWards    SamitiWard[]
  gramPanchayats GramPanchayat[]
  polls          Poll[]

  @@unique([districtId, nameEn])
  @@index([districtId])
  @@index([tehsilId])
}

model SamitiWard {
  id        String          @id @default(cuid())
  wardNo    Int
  nameHi    String
  samitiId  String
  samiti    PanchayatSamiti @relation(fields: [samitiId], references: [id], onDelete: Cascade)
  villages  Village[]
  polls     Poll[]
  createdAt DateTime        @default(now())

  @@unique([samitiId, wardNo])
  @@index([samitiId])
}

model Village {
  id     String     @id @default(cuid())
  nameEn String
  nameHi String
  wardId String
  ward   SamitiWard @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([wardId, nameEn])
  @@index([wardId])
}

model GramPanchayat {
  id         String          @id @default(cuid())
  nameEn     String
  nameHi     String
  districtId String
  district   District        @relation(fields: [districtId], references: [id], onDelete: Cascade)
  samitiId   String
  samiti     PanchayatSamiti @relation(fields: [samitiId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([samitiId, nameEn])
  @@index([districtId])
  @@index([samitiId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([createdAt])
}