datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PollScope {
  NATIONAL
  STATE
}

model Poll {
  id           String  @id @default(uuid())
  slug         String? @unique @db.VarChar(500)
  question     String  @db.VarChar(500)
  creatorName  String? @db.VarChar(100)
  creatorEmail String? @db.VarChar(255)
  creatorIp    String? @db.VarChar(45)

  isVerified   Boolean @default(false)
  deadlineDays Int     @default(3)
  active       Boolean @default(true)

  scope     PollScope @default(NATIONAL)
  stateCode String?   @db.VarChar(10)
  shareCode String?   @unique @db.VarChar(16)
  creatorGuestHash String? @db.VarChar(64)
  creatorReference String? @unique @db.VarChar(32)
  deletionStatus String @default("NONE") @db.VarChar(30)
  deletionRequestedAt DateTime?

  categoryType  String  @default("non-political")
  requiresLogin Boolean @default(false)
  topic         String? @db.VarChar(30)

  termsAgreed     Boolean   @default(false)
  termsVersion    String?   @db.VarChar(30)
  termsAcceptedAt DateTime?

  districtName      String? @db.VarChar(100)
  samitiName        String? @db.VarChar(100)
  gramPanchayatName String? @db.VarChar(100)
  gramPanchayatId   String?

  // assembly | sarpanch | samiti | zila
  electionType String? @default("sarpanch") @db.VarChar(50)

  districtId String?
  district   District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  samitiId String?
  samiti   PanchayatSamiti? @relation(fields: [samitiId], references: [id], onDelete: SetNull)

  samitiWardId String?
  samitiWard   SamitiWard? @relation(fields: [samitiWardId], references: [id], onDelete: SetNull)

  zilaWardId String?
  zilaWard   ZilaParishadWard? @relation(fields: [zilaWardId], references: [id], onDelete: SetNull)

  assemblyId String?
  assembly   AssemblyConstituency? @relation(fields: [assemblyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options PollOption[]
  votes   Vote[]

  @@index([active])
  @@index([scope, stateCode, active, createdAt])
  @@index([createdAt])
  @@index([categoryType])
  @@index([districtName])
  @@index([samitiName])
  @@index([gramPanchayatName])
  @@index([gramPanchayatId])
  @@index([electionType])
  @@index([districtId])
  @@index([samitiId])
  @@index([samitiWardId])
  @@index([zilaWardId])
  @@index([requiresLogin])
  @@index([assemblyId])
}

model PollOption {
  id        String   @id @default(uuid())
  pollId    String
  text      String   @db.VarChar(255)
  voteCount Int      @default(0)
  order     Int?
  createdAt DateTime @default(now())

  poll  Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@index([pollId])
}

model Vote {
  id              String  @id @default(uuid())
  pollId          String
  optionId        String
  anonymousUserId String  @db.VarChar(100)
  ipAddress       String? @db.VarChar(45)
  deviceSig       String? @db.VarChar(64)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, anonymousUserId])
  @@index([pollId, ipAddress])
  @@index([pollId])
  @@index([optionId])
  @@index([anonymousUserId])
  @@index([createdAt])
  @@index([pollId, createdAt])
  @@index([userId])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(255)
  whatsapp  String?  @db.VarChar(20)
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Authentication

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  votes    Vote[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Administrative locations

model District {
  id        String   @id @default(cuid())
  nameEn    String   @unique
  nameHi    String
  stateCode String?  @db.VarChar(10)
  createdAt DateTime @default(now())

  tehsils          Tehsil[]
  panchayatSamitis PanchayatSamiti[]
  gramPanchayats   GramPanchayat[]
  zilaWards        ZilaParishadWard[]
  polls            Poll[]
  assemblyMappings AssemblyDistrict[]

  @@index([nameEn])
}

model ZilaParishadWard {
  id         String @id @default(cuid())
  wardNo     Int
  nameHi     String
  districtId String

  district District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  polls    Poll[]

  @@unique([districtId, wardNo])
  @@index([districtId])
}

model Tehsil {
  id         String @id @default(cuid())
  nameEn     String
  nameHi     String
  districtId String

  district         District          @relation(fields: [districtId], references: [id], onDelete: Cascade)
  panchayatSamitis PanchayatSamiti[]

  @@unique([districtId, nameEn])
  @@index([districtId])
}

model PanchayatSamiti {
  id         String  @id @default(cuid())
  nameEn     String
  nameHi     String
  districtId String
  tehsilId   String?

  district District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  tehsil   Tehsil?  @relation(fields: [tehsilId], references: [id], onDelete: SetNull)

  samitiWards    SamitiWard[]
  gramPanchayats GramPanchayat[]
  polls          Poll[]

  @@unique([districtId, nameEn])
  @@index([districtId])
  @@index([tehsilId])
}

model SamitiWard {
  id        String   @id @default(cuid())
  wardNo    Int
  nameHi    String
  samitiId  String
  createdAt DateTime @default(now())

  samiti   PanchayatSamiti @relation(fields: [samitiId], references: [id], onDelete: Cascade)
  villages Village[]
  polls    Poll[]

  @@unique([samitiId, wardNo])
  @@index([samitiId])
}

model Village {
  id     String @id @default(cuid())
  nameEn String
  nameHi String
  wardId String

  ward SamitiWard @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@unique([wardId, nameEn])
  @@index([wardId])
}

model GramPanchayat {
  id         String   @id @default(cuid())
  nameEn     String
  nameHi     String
  districtId String
  samitiId   String
  createdAt  DateTime @default(now())

  district District        @relation(fields: [districtId], references: [id], onDelete: Cascade)
  samiti   PanchayatSamiti @relation(fields: [samitiId], references: [id], onDelete: Cascade)

  @@unique([samitiId, nameEn])
  @@index([districtId])
  @@index([samitiId])
}

// Assembly constituencies and district mappings

model AssemblyConstituency {
  id         String   @id @default(cuid())
  stateCode  String   @db.VarChar(10)
  seatNumber Int
  nameHi     String   @db.VarChar(150)
  nameEn     String?  @db.VarChar(150)
  createdAt  DateTime @default(now())

  districts AssemblyDistrict[]
  polls     Poll[]

  @@unique([stateCode, seatNumber])
  @@index([stateCode, nameHi])
}

model AssemblyDistrict {
  assemblyId String
  districtId String

  assembly AssemblyConstituency @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  district District             @relation(fields: [districtId], references: [id], onDelete: Restrict)

  @@id([assemblyId, districtId])
  @@index([districtId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Article {
  id String @id @default(cuid())
  slug String @unique @db.VarChar(160)
  title String @db.VarChar(250)
  author String @db.VarChar(120)
  summary String @db.VarChar(600)
  content String @db.Text
  sources String @db.Text
  published Boolean @default(false)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([published, publishedAt])
}
model Announcement {
  id String @id @default(cuid())
  title String @db.VarChar(200)
  body String @db.VarChar(1000)
  href String? @db.VarChar(500)
  active Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([active, createdAt])
}
