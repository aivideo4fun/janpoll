datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Poll {
  id                  String   @id @default(uuid())
  slug                String?  @db.VarChar(500)
  question            String   @db.VarChar(500)
  creatorName         String?  @db.VarChar(100)
  creatorEmail        String?  @db.VarChar(255)
  isVerified          Boolean  @default(false)
  creatorIp           String?  @db.VarChar(45)
  deadlineDays        Int      @default(3)
  active              Boolean  @default(true)
  
  // 📍 Location Fields
  districtName        String?  @db.VarChar(100)
  samitiName          String?  @db.VarChar(100)
  gramPanchayatName   String?  @db.VarChar(100)
  gramPanchayatId     String?  // 👈 यहाँ Int? की जगह String? कर लें

      createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  options             PollOption[]
  votes               Vote[]

  @@index([active])
  @@index([createdAt])
  @@index([districtName])
  @@index([gramPanchayatName])
  @@index([gramPanchayatId])
}

model PollOption {
  id        String   @id @default(uuid())
  pollId    String
  text      String   @db.VarChar(255)
  voteCount Int      @default(0)
  order     Int?     // 👈 इसे Optional (Int?) रखें ताकि पुराने पोल्स सुरक्षित रहें
  createdAt DateTime @default(now())

  poll  Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@index([pollId])
}

model Vote {
  id              String   @id @default(uuid())
  pollId          String
  optionId        String
  anonymousUserId String   @db.VarChar(100)
  ipAddress       String?  @db.VarChar(45)
  createdAt       DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, anonymousUserId])
  @@index([pollId, ipAddress])
  @@index([pollId])
  @@index([optionId])
  @@index([anonymousUserId])
  @@index([createdAt])
  @@index([pollId, createdAt])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(255)
  whatsapp  String?  @db.VarChar(20)   // 👈 नया WhatsApp फील्ड (ऑपशनल)
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------
// RAJASTHAN LOCAL BODY HIERARCHY MODELS
// ---------------------------------------------------------

model District {
  id               String             @id @default(cuid())
  nameEn           String             @unique
  nameHi           String
  tehsils          Tehsil[]
  panchayatSamitis PanchayatSamiti[]
  gramPanchayats   GramPanchayat[]
  zilaWards        ZilaParishadWard[]
  createdAt        DateTime           @default(now())
}

model ZilaParishadWard {
  id         String   @id @default(cuid())
  wardNo     Int
  nameHi     String
  districtId String
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@unique([districtId, wardNo])
}

model Tehsil {
  id               String            @id @default(cuid())
  nameEn           String
  nameHi           String
  districtId       String
  district         District          @relation(fields: [districtId], references: [id], onDelete: Cascade)
  panchayatSamitis PanchayatSamiti[]

  @@unique([districtId, nameEn])
}

model PanchayatSamiti {
  id             String          @id @default(cuid())
  nameEn         String
  nameHi         String
  districtId     String
  district       District        @relation(fields: [districtId], references: [id], onDelete: Cascade)
  tehsilId       String?
  tehsil         Tehsil?         @relation(fields: [tehsilId], references: [id], onDelete: SetNull)
  gramPanchayats GramPanchayat[]

  @@unique([districtId, nameEn])
  @@index([tehsilId])
}

model GramPanchayat {
  id         String          @id @default(cuid())
  nameEn     String
  nameHi     String
  districtId String
  district   District        @relation(fields: [districtId], references: [id], onDelete: Cascade)
  samitiId   String
  samiti     PanchayatSamiti @relation(fields: [samitiId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([samitiId, nameEn])
  @@index([districtId])
}