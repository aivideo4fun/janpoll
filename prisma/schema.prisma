datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Poll {
  id           String   @id @default(uuid())
  slug         String?  @db.VarChar(500) // 👈 Optional rakha hai taaki purane polls safe rahein
  question     String   @db.VarChar(500)
  creatorName  String?  @db.VarChar(100)
  creatorEmail String?  @db.VarChar(255)
  isVerified   Boolean  @default(false)
  creatorIp    String?  @db.VarChar(45)
  deadlineDays Int      @default(3)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  options PollOption[]
  votes   Vote[]

  @@index([active])
  @@index([createdAt])
}

model PollOption {
  id        String   @id @default(uuid())
  pollId    String
  text      String   @db.VarChar(255)
  voteCount Int      @default(0)
  createdAt DateTime @default(now())

  poll  Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes Vote[]

  @@index([pollId])
  @@index([pollId, createdAt])
}

model Vote {
  id              String   @id @default(uuid())
  pollId          String
  optionId        String
  anonymousUserId String   @db.VarChar(100)
  ipAddress       String?  @db.VarChar(45)
  createdAt       DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, anonymousUserId])
  @@index([pollId, ipAddress])
  @@index([pollId])
  @@index([optionId])
  @@index([anonymousUserId])
  @@index([createdAt])
  @@index([pollId, createdAt])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(255)
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}